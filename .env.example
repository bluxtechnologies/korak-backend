APP_NAME="Korak API"
APP_ENV=local
APP_KEY=
# Must be false outside local (Doc 08)
APP_DEBUG=true
APP_URL=http://localhost:8070
FRONTEND_URL=http://localhost:3000

# -- Sanctum / CORS (B2.5) --------------------------------------------------
# Comma-separated list of SPA origins that receive stateful session cookies.
# No trailing slashes. Production: korakdigital.com,www.korakdigital.com,app.korakdigital.com,backend.korakdigital.com
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8070
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Session cookie hardening (Doc 04)
# Production: SESSION_DOMAIN=.korakdigital.com, SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=korak_backend
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=korak_session
# Set true in production (HTTPS)
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailhog local email testing (SMTP: 127.0.0.1:1025 | Web UI: http://localhost:8025)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@korakdigitals.com"
MAIL_FROM_NAME="Korak Digitals"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# FinityPay / CoFinance (VTU & Payment Gateway)
FINITYPAY_ENV=production
COFINANCE_BASE_URL=https://api.cofinance.ng/v1
COFINANCE_BUSINESS_ID=
COFINANCE_PUBLIC_KEY=
COFINANCE_SECRET_KEY=
COFINANCE_WEBHOOK_SECRET=
FINITYPAY_WEBHOOK_SECRET=
FINITYPAY_SKIP_WEBHOOK_VERIFY=false

FINITYPAY_ENV=sandbox
FINITYPAY_WEBHOOK_SECRET=
COFINANCE_BASE_URL=https://api.cofinance.ng/v1
COFINANCE_BUSINESS_ID=
COFINANCE_PUBLIC_KEY=
COFINANCE_SECRET_KEY=
COFINANCE_WEBHOOK_SECRET=
FINITYPAY_SKIP_WEBHOOK_VERIFY=false
