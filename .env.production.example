APP_NAME="Korak API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://backend.korakdigital.com
FRONTEND_URL=https://korakdigital.com

# -- Sanctum / CORS -----------------------------------------------------------
# Comma-separated list of SPA origins that receive stateful session cookies (no trailing slashes, no scheme).
SANCTUM_STATEFUL_DOMAINS=korakdigital.com,www.korakdigital.com,app.korakdigital.com,backend.korakdigital.com

# Comma-separated list of origins allowed by CORS.
CORS_ALLOWED_ORIGINS=https://korakdigital.com,https://www.korakdigital.com,https://app.korakdigital.com

# -- Session Cookie Hardening -------------------------------------------------
# Leading dot allows session cookies to be shared across subdomains
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.korakdigital.com
SESSION_COOKIE=korak_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -- Database Configuration (cPanel MySQL) ------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=korakdlg_backend
DB_USERNAME=korakdlg_user
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# -- Email Configuration -------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.korakdigital.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@korakdigital.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@korakdigital.com"
MAIL_FROM_NAME="Korak Digital"

# -- Third-party API Credentials (VTU & Payments) ------------------------------
FINITYPAY_ENV=production
FINITYPAY_BASE_URL=https://api.finitypay.com.ng/v1
FINITYPAY_BUSINESS_ID=
FINITYPAY_PUBLIC_KEY=
FINITYPAY_SECRET_KEY=
FINITYPAY_WEBHOOK_SECRET=
FINITYPAY_BANK_PARTNER=wema
FINITYPAY_SKIP_WEBHOOK_VERIFY=false
MOCK_PAYMENT_PROVIDER=false

# Legacy aliases (matching above values)
COFINANCE_BASE_URL=https://api.finitypay.com.ng/v1
COFINANCE_BUSINESS_ID=
COFINANCE_PUBLIC_KEY=
COFINANCE_SECRET_KEY=
COFINANCE_WEBHOOK_SECRET=
